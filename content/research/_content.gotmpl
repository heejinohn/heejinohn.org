{{- /* Makes one page per paper in cv/papers.yaml (mounted as site data).
       The abstract becomes the page text. Each page gets two extra params:
       `list` (its list in papers.yaml) and `group` (its website group from
       params.paperGroups in hugo.toml). */ -}}

{{- /* Which website group each papers.yaml list belongs to. */ -}}
{{- $groupOf := dict -}}
{{- range .Site.Params.paperGroups -}}
  {{- $g := . -}}
  {{- range .lists }}{{ $groupOf = merge $groupOf (dict . $g) }}{{ end -}}
{{- end -}}

{{- range $list, $papers := hugo.Data.papers -}}
  {{- $g := index $groupOf $list -}}
  {{- if not $g -}}
    {{- errorf "cv/papers.yaml: list %q is not in any params.paperGroups in hugo.toml" $list -}}
  {{- end -}}
  {{- range $i, $p := $papers -}}
    {{- if not (and $p.slug $p.title $p.authors) -}}
      {{- errorf "cv/papers.yaml: entry %d under %q needs slug, title and authors" (add $i 1) $list -}}
    {{- end -}}
    {{- $.AddPage (dict
          "kind" "page"
          "type" "paper"
          "path" $p.slug
          "title" $p.title
          "params" (merge $p (dict "list" $list "group" $g.heading "label" ($g.label | default "")))
          "content" (dict "mediaType" "text/markdown" "value" ($p.abstract | default ""))
        ) -}}
  {{- end -}}
{{- end -}}
